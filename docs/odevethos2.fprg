<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="odevethos2"/>
        <attribute name="authors" value="USER"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-09 09:23:34 &#214;S"/>
        <attribute name="created" value="VVNFUjtERVNLVE9QLUNUVTc3UlU7MjAyNi0xMS0wOTswODo1OTowMiDDllM7Mjg0NA=="/>
        <attribute name="edited" value="VVNFUjtERVNLVE9QLUNUVTc3UlU7MjAyNi0xMS0wOTswOToyMzozNCDDllM7MTsyOTQ5"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="dogru, yanl&#305;s, bos" type="Integer" array="False" size=""/>
            <declare name="net" type="Real" array="False" size=""/>
            <declare name="basari" type="String" array="False" size=""/>
            <output expression="&quot;Dogru sayisini giriniz:&quot;" newline="True"/>
            <input variable="dogru"/>
            <output expression="&quot;Yanlis sayisini giriniz:&quot;" newline="True"/>
            <input variable="yanlis"/>
            <if expression="dogru &gt;= 0 and yanlis &gt;= 0 and dogru + yanlis &lt;= 20">
                <then>
                    <assign variable="bos" expression="20 - (dogru + yanlis)"/>
                    <assign variable="net" expression="dogru - yanlis / 4.0"/>
                    <if expression="net &lt;= 5">
                        <then>
                            <assign variable="basari" expression="&quot;Gelismeli&quot;"/>
                        </then>
                        <else>
                            <if expression="net &lt;= 10">
                                <then>
                                    <assign variable="basari" expression="&quot;Orta&quot;"/>
                                </then>
                                <else>
                                    <if expression="net &lt;= 15">
                                        <then>
                                            <assign variable="basari" expression="&quot;Iyi&quot;"/>
                                        </then>
                                        <else>
                                            <assign variable="basari" expression="&quot;Cok iyi&quot;"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                    <output expression="&quot;Bos sayisi:&quot;" newline="True"/>
                    <output expression="bos" newline="True"/>
                    <output expression="&quot;Net sayisi:&quot;" newline="True"/>
                    <output expression="net" newline="True"/>
                    <output expression="&quot;Basari durumu:&quot;" newline="True"/>
                    <output expression="basari" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Yanlis sayi girdiniz.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
